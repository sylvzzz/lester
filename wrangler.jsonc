{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lester",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b"
  }
}
